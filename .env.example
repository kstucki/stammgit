# Copy to .env and adjust. Existing environment variables take precedence.

# Admin password (full access). Required.
FAMILY_TREE_PASSWORD=change-me

# Optional: password for the read-only "user" role.
FAMILY_TREE_USER_PASSWORD=

# Optional: enable sync, uploads and dataset switching (Git commits).
# Fine-grained token with Contents: Read/Write for exactly this repository.
GITHUB_TOKEN=
GITHUB_REPO=
GITHUB_BRANCH=main

# Optional: port for server.mjs (default 8888)
PORT=8888
