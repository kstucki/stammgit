{
  "name": "stammgit",
  "version": "0.9.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "npm run build:data && npm run check && npm run test:unit && node scripts/build-frontend.mjs",
    "build:data": "npm test && node scripts/build-data.mjs",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc --noEmit -p tsconfig.tools.json",
    "test": "node scripts/test.mjs",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:dev": "STAMMGIT_TEST_MODE=dev playwright test --project=desktop",
    "start": "npm run build && node server.mjs",
    "dev": "npm run build:data && node server.mjs --dev",
    "metrics": "node scripts/layout-metrics.mjs",
    "test:server": "node scripts/test-server.mjs"
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@types/node": "24.13.6",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "4.1.11"
  }
}
